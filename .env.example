# Copie para .env e preencha. O .env nao vai para o repositorio.
# Em producao (Hugging Face Spaces), definir como secrets do Space, nunca no codigo.

LLM_API_KEY=

# Provedor. Qualquer um compativel com a API de chat completions da OpenAI serve --
# trocar de provedor e mudar estas duas linhas.
#
# Groq:     https://api.groq.com/openai/v1                          + llama-3.3-70b-versatile
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai + gemini-2.0-flash
# DeepSeek: https://api.deepseek.com/v1                             + deepseek-chat

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
